<!doctype html>
<html lang="zh-CN">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ .Type }} {{ .Width }}x{{ .Height }} - {{ .Site.Name }}</title>
    {{ if .Site.HasAnalytics }}<script defer src="{{ .Site.AnalyticsScript }}"{{ if .Site.AnalyticsID }} data-website-id="{{ .Site.AnalyticsID }}"{{ end }}></script>{{ end }}
    <link rel="stylesheet" href="/assets/main.min.css?v={{ .Site.AssetVersion }}">
</head>

<body class="page-image-detail">
    <main class="wrap" data-track-base-url="{{ .TrackBaseURL }}">
        <div class="topbar">
            <a class="brand" href="{{ .HomeURL }}">
                <span class="brand-mark"><img src="/assets/logo.png" alt="{{ .Site.Name }} logo"></span>
                <span>{{ .Site.Name }}</span>
            </a>
            <div class="meta-badges">
                <span class="type-badge">{{ .TypeLabel }} <em>{{ .Type }}</em></span>
                <span class="meta-badge"><strong>图库数量</strong><span>{{ .SourceLibraryCount }} 张</span></span>
                <span class="meta-badge"><strong>缓存数量</strong><span>{{ .ProfileRenderCount }} 张</span></span>
            </div>
        </div>

        <section class="hero">
            <div class="preview" view-image>
                <img class="viewer-image" src="{{ .LocalImageURL }}" alt="{{ .Site.Name }} preview" loading="eager">
                <div class="stats">
                    <div class="stat"><strong>图片格式</strong><span>{{ .FormatLabel }}</span></div>
                    <div class="stat"><strong>图片尺寸</strong><span>{{ .CurrentMeta.Width }}x{{ .CurrentMeta.Height }}</span></div>
                    <div class="stat"><strong>生成时间</strong><span data-timestamp="{{ .GeneratedAt }}"></span></div>
                    <div class="stat"><strong>文件大小</strong><span>{{ .CurrentMeta.SizeHuman }}</span></div>
                    <div class="stat"><strong>页面浏览</strong><span id="view-count">{{ .ViewCount }}</span></div>
                    <div class="stat"><strong>下载次数</strong><span id="download-count">{{ .DownloadCount }}</span></div>
                </div>
            </div>
        </section>

        <section class="panel">
            <table class="info-table">
                {{ if .RValue }}
                    <tr>
                        <th>固定参数</th>
                        <td>{{ .RValue }}</td>
                    </tr>
                {{ end }}
                {{ if .SValue }}
                    <tr>
                        <th>图片位</th>
                        <td>{{ .SValue }}</td>
                    </tr>
                {{ end }}
                {{ if .Keyword }}
                    <tr>
                        <th>关键词</th>
                        <td>{{ .Keyword }}</td>
                    </tr>
                {{ end }}
            </table>

            <div class="links-grid">
                <div class="link-card">
                    <div class="link-card-head">
                        <h3>引用链接</h3>
                        <div class="icon-actions">
                            <button type="button" data-open="{{ .DirectImageURL }}" aria-label="打开转换后图片地址" title="打开">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path d="M14 4h6v6"></path>
                                    <path d="M10 14L20 4"></path>
                                    <path d="M20 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h4"></path>
                                </svg>
                            </button>
                            <button type="button" data-download="{{ .DownloadURL }}" aria-label="下载转换后图片" title="下载">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path d="M12 3v12"></path>
                                    <path d="M7 10l5 5 5-5"></path>
                                    <path d="M5 21h14"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="link-card-body">
                    <div class="format-list">
                        {{ range .ImageFormats }}
                            <div class="format-row">
                                <div class="format-label">{{ .Label }}</div>
                                <div class="format-value mono">{{ .Value }}</div>
                                <button type="button" data-copy="{{ .Value }}" aria-label="复制{{ .Label }}" title="复制 {{ .Label }}">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <rect x="9" y="9" width="10" height="10"></rect>
                                        <path d="M5 15V5h10"></path>
                                    </svg>
                                </button>
                            </div>
                        {{ end }}
                    </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <script>
    document.querySelectorAll('[data-timestamp]').forEach(function(el){
        var ts = parseInt(el.getAttribute('data-timestamp'), 10);
        if (!ts) return;
        var d = new Date(ts * 1000);
        var y = d.getFullYear();
        var m = String(d.getMonth() + 1).padStart(2, '0');
        var day = String(d.getDate()).padStart(2, '0');
        var h = String(d.getHours()).padStart(2, '0');
        var min = String(d.getMinutes()).padStart(2, '0');
        el.textContent = y + '-' + m + '-' + day + ' ' + h + ':' + min;
    });
    </script>
    <script defer src="/assets/main.min.js?v={{ .Site.AssetVersion }}"></script>
</body>

</html>
