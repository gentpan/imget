# ============================================================
# imget — environment configuration
#
# Copy this file to .env and fill in real values.
# Every runtime knob lives here; there is NO admin UI.
# Empty values fall back to the documented defaults.
# ============================================================

# ============================================================
# 1. HTTP server
# ============================================================
# Address the Go service listens on. Use 127.0.0.1:PORT to keep it
# behind nginx; use :PORT to expose it directly.
HTTP_ADDR=:8080

# Public site URL. Used in og:url, canonical, share buttons,
# code samples on the home page, etc.
SITE_BASE_URL=http://localhost:8080

# ============================================================
# 2. Storage paths
# ============================================================
# Static assets (CSS / JS / favicon / logo) are EMBEDDED in the binary.
# Templates are ALSO embedded; set TEMPLATES_DIR only if you want to
# override them with on-disk *.html.tmpl files for local theming.
DB_PATH=database/imget.sqlite
IMAGES_DIR=images
TEMPLATES_DIR=

# ============================================================
# 3. Branding (visible to end users — set these for your fork)
# ============================================================
# Shown in <title>, brand mark, copyright line, og:site_name.
SITE_NAME=imget
# Optional Chinese / second-language tag shown next to the name (e.g. "图得").
# Leave blank to render only SITE_NAME.
SITE_TAGLINE=

# DMCA / copyright contact email. Empty -> footer hides the email link.
DMCA_EMAIL=

# Footer copyright year. 0 (or blank) -> auto-uses current year.
COPYRIGHT_YEAR=

# og:image. Empty -> falls back to ${SITE_BASE_URL}/assets/logo.png.
OG_IMAGE_URL=

# ============================================================
# 4. Frontend resources (open-source users can swap CDNs)
# ============================================================
# FontAwesome CSS URL. Empty -> icon classes (fa-light, etc.) won't render,
# the rest of the page still works.
FONTAWESOME_CSS_URL=https://static.litepic.io/libs/fontawesome/7.2.0/css/all.min.css

# Webfonts (Ubuntu + Google Sans Code) are bundled INSIDE main.min.css with
# @font-face rules pointing at https://static.litepic.io/fonts/*. To swap to
# a different webfont CDN, edit `internal/server/static/main.min.css` directly.

# Optional analytics (Umami-compatible). Empty -> no <script> emitted.
ANALYTICS_SCRIPT_URL=
ANALYTICS_WEBSITE_ID=

# ============================================================
# 5. Cloudflare R2 (S3-compatible) — leave R2_ENDPOINT blank to disable
# ============================================================
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_CDN_BASE_URL=
# When R2_REDIRECT_DIRECT=1, /files/* and /{w}/{h} requests redirect (302) to
# the CDN URL instead of streaming the file from disk. Saves bandwidth.
R2_REDIRECT_DIRECT=1
R2_UPLOAD_WORKERS=8
# Verify each upload with a HEAD request afterwards. Doubles request count to
# R2 — leave off unless you see corruption issues. Defaults to false.
R2_UPLOAD_VERIFY=0

# ============================================================
# 6. Pixabay — optional source
#    Without a key the service falls back to picsum.photos only
# ============================================================
PIXABAY_API_KEY=
PIXABAY_API_KEY_BACKUP=
PIXABAY_MIN_INTERVAL_MS=900
PIXABAY_COOLDOWN_SEC=300
PIXABAY_PER_PAGE=50

# ============================================================
# 7. Output formats
# ============================================================
# Comma-separated allow-list of formats the operator wants to enable.
# Effective formats = ENABLED_FORMATS ∩ installed encoders.
# Examples:
#   ENABLED_FORMATS=webp           # WebP only
#   ENABLED_FORMATS=webp,avif      # both
#   ENABLED_FORMATS=avif           # AVIF only (rare)
ENABLED_FORMATS=webp,avif

# Default format when the request omits ?format=. Must be in ENABLED_FORMATS.
DEFAULT_FORMAT=webp

WEBP_QUALITY=85
AVIF_QUALITY=60
AVIF_SPEED=6
AVIF_TIMEOUT_SEC=20
MIN_DIM=50
MAX_DIM=4000

# Image decoding/resizing/encoding is handled by libvips through govips —
# the system needs libvips42 installed (apt install libvips42 on Debian/Ubuntu,
# brew install vips on macOS). No per-encoder binary paths to configure.

# ============================================================
# 8. Image-fetch tuning
# ============================================================
# When a (w,h,type,keyword) combination has zero source images yet,
# the service prefetches this many before serving the first request.
INITIAL_PREFETCH_COUNT=5

# Each subsequent visit triggers a tiny background top-up of N images,
# keeping the pool fresh. Set to 0 to disable per-visit refetching.
PER_VISIT_REFETCH=1

# `imget daily-topup` adds this many new originals per active profile each day.
DAILY_TOPUP_INCREMENT=10

# Per-type cap; once a type already has this many sources the daily job stops
# fetching for that type. 0 = unlimited.
DAILY_TOPUP_MAX_PER_TYPE=1000

# Local rendered variants older than this (hours) are deleted by
# `imget cleanup-cache`, but only after the file is confirmed in R2.
LOCAL_RENDER_CACHE_TTL_HOURS=168

# ============================================================
# 9. Misc
# ============================================================
LOG_LEVEL=info
# Comma-separated allowlist of image type slugs accepted in URLs.
# Empty -> use the built-in 16-type set
# (banner, landscape, beauty, anime, city, nature, car, game, food,
#  animal, travel, space, tech, business, sports, architecture).
ALLOWED_TYPES=
