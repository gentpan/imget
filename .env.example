# ============================================================
# imget — environment configuration
#
# Copy this file to .env and fill in real values.
# Every runtime knob lives here; there is NO admin UI.
# Empty values fall back to the documented defaults.
# ============================================================

# ============================================================
# 1. HTTP server
# ============================================================
# Address the Go service listens on. Use 127.0.0.1:PORT to keep it
# behind nginx; use :PORT to expose it directly.
HTTP_ADDR=:8080

# Public site URL. Used in og:url, canonical, share buttons,
# code samples on the home page, etc.
SITE_BASE_URL=http://localhost:8080

# ============================================================
# 2. Storage paths
# ============================================================
# Static assets (CSS / JS / favicon / logo) are EMBEDDED in the binary.
# Templates are ALSO embedded; set TEMPLATES_DIR only if you want to
# override them with on-disk *.html.tmpl files for local theming.
DB_PATH=database/imget.sqlite
IMAGES_DIR=images
TEMPLATES_DIR=

# ============================================================
# 3. Branding (visible to end users — set these for your fork)
# ============================================================
# Shown in <title>, brand mark, copyright line, og:site_name.
SITE_NAME=imget
# Optional Chinese / second-language tag shown next to the name (e.g. "图得").
# Leave blank to render only SITE_NAME.
SITE_TAGLINE=

# DMCA / copyright contact email. Empty -> footer hides the email link.
DMCA_EMAIL=

# Footer copyright year. 0 (or blank) -> auto-uses current year.
COPYRIGHT_YEAR=

# og:image. Empty -> falls back to ${SITE_BASE_URL}/assets/logo.png.
OG_IMAGE_URL=

# ============================================================
# 4. Frontend resources (open-source users can swap CDNs)
# ============================================================
# FontAwesome CSS URL. Empty -> icon classes (fa-light, etc.) won't render,
# the rest of the page still works.
FONTAWESOME_CSS_URL=https://static.bluecdn.com/libs/fontawesome/7.2.0/css/all.min.css

# Webfonts (Ubuntu + Google Sans Code) are bundled INSIDE main.min.css with
# @font-face rules pointing at https://static.bluecdn.com/fonts/*. To swap to
# a different webfont CDN, edit `internal/server/static/main.min.css` directly.

# Optional analytics (Umami-compatible). Empty -> no <script> emitted.
ANALYTICS_SCRIPT_URL=https://tongji.giantaccel.com/script.js
ANALYTICS_WEBSITE_ID=dfe72df0-719f-4ad2-af39-cfea2465dd44

# ============================================================
# 5. Cloudflare R2 (S3-compatible) — leave R2_ENDPOINT blank to disable
# ============================================================
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_CDN_BASE_URL=
# When R2_REDIRECT_DIRECT=1, /files/* and /{w}/{h} requests redirect (302) to
# the CDN URL instead of streaming the file from disk. Saves bandwidth.
R2_REDIRECT_DIRECT=1
R2_UPLOAD_WORKERS=8
# Verify each upload with a HEAD request afterwards. Doubles request count to
# R2 — leave off unless you see corruption issues. Defaults to false.
R2_UPLOAD_VERIFY=0

# ============================================================
# 6. Image sources — Pexels (preferred) + Pixabay (fallback)
# ============================================================
# Provider chain at runtime: Pexels -> Pixabay -> Picsum.
# `source.Chain` returns the first provider that yields >=1 URL, so configure
# at least one of Pexels / Pixabay to get real photos. Picsum is procedural
# (Lorem Picsum) and only fires when an explicit W/H is provided.
#
# --- Pexels (free, https://www.pexels.com/api/) ---
# Returns `src.original` (the actual 4K-8K upload). Without a key the provider
# is silently disabled.
PEXELS_API_KEY=
# Drop Pexels hits whose declared width is below this many pixels. Default
# 1920 (Full HD). Raise to 2560 to bias toward 2K+, 3840 for strict 4K only.
PEXELS_MIN_WIDTH=1920
PEXELS_PER_PAGE=30
PEXELS_MIN_INTERVAL_MS=1000
PEXELS_COOLDOWN_SEC=300

# --- Pixabay (free, https://pixabay.com/api/) ---
# Standard tier returns largeImageURL (1280px max). Apply for Full API access
# at https://pixabay.com/service/about/api/ to unlock imageURL (originals up
# to 6K-8K). `pickPixabayURL` already prefers imageURL > fullHDURL >
# largeImageURL, so no code change is needed once approved.
PIXABAY_API_KEY=
PIXABAY_API_KEY_BACKUP=
PIXABAY_MIN_INTERVAL_MS=900
PIXABAY_COOLDOWN_SEC=300
PIXABAY_PER_PAGE=50

# ---- CC / high-volume providers (used by the topup FetchAll union) ----
# These broaden the fetch corpus far beyond Pexels/Pixabay so the pool can grow
# toward large targets. The topup job queries EVERY enabled provider and unions
# the results; sub-keywords (source/subkeywords.go) rotate the search phrase so
# each run opens a fresh window. Images stay filed under the 20 parent types.
#
# Wikimedia Commons — ~100M CC/PD files, no key. Set a descriptive UA (policy).
WIKIMEDIA_ENABLED=true
WIKIMEDIA_USER_AGENT=
# Openverse — 600M+ CC images. Works anonymously (low quota); a free registered
# app (client id/secret) raises the limit ~100x and is fetched as a bearer token.
OPENVERSE_ENABLED=true
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Unsplash — true originals, requires a free Access Key. Empty disables it.
UNSPLASH_ACCESS_KEY=
# Bing daily wallpaper — one curated 4K scenic photo per day, no key. Only feeds
# the "landscape" bucket. BING_MARKET picks the regional edition (e.g. en-US, zh-CN).
BING_ENABLED=true
BING_MARKET=en-US

# ============================================================
# 7. Output formats
# ============================================================
# Comma-separated allow-list of formats the operator wants to enable.
# Effective formats = ENABLED_FORMATS ∩ installed encoders.
# Examples:
#   ENABLED_FORMATS=webp           # WebP only
#   ENABLED_FORMATS=webp,avif      # both
#   ENABLED_FORMATS=avif           # AVIF only (rare)
ENABLED_FORMATS=webp,avif

# Default format when the request omits ?format=. Must be in ENABLED_FORMATS.
DEFAULT_FORMAT=webp

WEBP_QUALITY=85
AVIF_QUALITY=60
AVIF_SPEED=6
AVIF_TIMEOUT_SEC=20
MIN_DIM=50
MAX_DIM=4000

# Image decoding/resizing/encoding is handled by libvips through govips —
# the system needs libvips42 installed (apt install libvips42 on Debian/Ubuntu,
# brew install vips on macOS). No per-encoder binary paths to configure.

# ============================================================
# 8. Image-fetch tuning
# ============================================================
# When a (w,h,type,keyword) combination has zero source images yet,
# the service prefetches this many before serving the first request.
INITIAL_PREFETCH_COUNT=5

# Each subsequent visit triggers a tiny background top-up of N images,
# keeping the pool fresh. Set to 0 to disable per-visit refetching.
PER_VISIT_REFETCH=1

# Legacy `imget daily-topup` (walks request_profiles) — kept for back-compat.
# Prefer `imget topup-types` for fresh ingestion; tune its volume with the
# TOPUP_TYPES_* knobs below instead.
DAILY_TOPUP_INCREMENT=10
DAILY_TOPUP_MAX_PER_TYPE=1000

# `imget topup-types` walks AllowedTypes (currently 20) and fetches a random
# count in [MIN, MAX] per category each run. 30..50 -> roughly 480-800 fresh
# originals/day at 50 categories. Drop to 5..10 for low-volume.
TOPUP_TYPES_MIN_PER_TYPE=5
TOPUP_TYPES_MAX_PER_TYPE=10

# Local rendered variants older than this (hours) are deleted by
# `imget cleanup-cache`, but only after the file is confirmed in R2.
LOCAL_RENDER_CACHE_TTL_HOURS=168

# ============================================================
# 9. Misc
# ============================================================
LOG_LEVEL=info
# Comma-separated allowlist of image type slugs accepted in URLs.
# Empty -> use the built-in 20-type set:
#   banner, landscape, beauty, anime, city, nature, car, game, food,
#   animal, travel, space, tech, business, sports, architecture,
#   wedding, kids, abstract, concert.
# Each type gets a Chinese label + FontAwesome icon registered in
# internal/server/labels.go.
ALLOWED_TYPES=
